# =============================================================================
# NeoMutt main configuration
# =============================================================================
#
# ~/.config/neomutt/muttrc
#
# Account-specific configs go in ~/.config/neomutt/accounts/ and are sourced
# automatically.  Those files are gitignored — do not commit credentials.
#
# Local overrides (editor path, mailboxes, etc.) go in
# ~/.config/neomutt/muttrc.local — also gitignored.
# =============================================================================

# ---------------------------------------------------------------------------
#  Editor / Pager
# ---------------------------------------------------------------------------
set editor = "vim"
set pager = "builtin"
set pager_context = 5
set pager_index_lines = 10
set pager_stop = yes
set quit = ask-yes

# ---------------------------------------------------------------------------
#  Index / Headers
# ---------------------------------------------------------------------------
set sort = "reverse-date-received"
set sort_aux = "reverse-date-received"
set sort_browser = "reverse-date"
set index_format = "%4C %Z %{%b %d %Y} %-15.15L (%?l?%4l&%4c?) %s"
set date_format = "%Y-%m-%d %H:%M"
set header_cache = "~/.cache/neomutt/headers"
set message_cachedir = "~/.cache/neomutt/messages"
set certificate_file = "~/.cache/neomutt/certificates"

# ---------------------------------------------------------------------------
#  Sidebar
# ---------------------------------------------------------------------------
set sidebar_visible = yes
set sidebar_width = 20
set sidebar_format = "%B%?F? [%F]?%* %?N?%N/?%S"
set sidebar_sort_method = "unsorted"
bind index,pager \Cp sidebar-prev
bind index,pager \Cn sidebar-next
bind index,pager \Co sidebar-open

# ---------------------------------------------------------------------------
#  Composition
# ---------------------------------------------------------------------------
set realname = ""
set from = ""
set use_from = yes
set envelope_from = yes
set sig_dashes = yes
set edit_headers = yes
set fast_reply = yes
set include = yes
set forward_format = "Fwd: %s"
set forward_decode = yes
set attribution = "On %{%Y-%m-%d %H:%M}, %L wrote:"

# ---------------------------------------------------------------------------
#  Attachments (mailcap)
# ---------------------------------------------------------------------------
set mailcap_path = "~/.config/neomutt/mailcap"
set print_command = "lpr"

# ---------------------------------------------------------------------------
#  Notmuch integration
# ---------------------------------------------------------------------------
set virtual_spoolfile = yes
# NeoMutt renamed nm_query_window_timeout to nm_open_timeout; the old name is
# rejected as an unknown option on current releases.
set nm_open_timeout = 0

macro index,pager \\ "T~U<enter>;@T<enter>C~/%20<enter>y" "Tag all unread, move to trash"

# ---------------------------------------------------------------------------
#  GPG
# ---------------------------------------------------------------------------
set pgp_default_key = ""
set pgp_use_gpg_agent = yes
set crypt_autosign = no
set crypt_autoencrypt = no
set crypt_replyencrypt = yes
set crypt_replysign = yes
set crypt_opportunistic_encrypt = yes
# Distro example GPG/SSYANG configs. NeoMutt has no conditional `source`, and
# Fedora's neomutt RPM does not ship /usr/share/doc/neomutt/examples, so these
# are opt-in: copy the files from your distro's neomutt examples (or the
# upstream repo) into ~/.config/neomutt/ and uncomment the lines below.
# if have_crypto_command gpg
#   source /usr/share/doc/neomutt/examples/gpg.rc
#   source /usr/share/doc/neomutt/examples/ssypan.rc
# endif

# ---------------------------------------------------------------------------
#  Account configs  (gitignored — user-provided)
# ---------------------------------------------------------------------------
source ~/.config/neomutt/accounts/*.muttrc 2>/dev/null

# ---------------------------------------------------------------------------
#  Local overrides  (gitignored — user-provided)
# ---------------------------------------------------------------------------
source ~/.config/neomutt/muttrc.local 2>/dev/null
