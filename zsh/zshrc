# PATH

# Root of LinuxSetup ZSH config (resolved dynamically, no hardcoded path)
ZSH_ROOT="${${(%):-%x}:A:h}"

export PATH="$ZSH_ROOT/bin:$PATH"

source "$ZSH_ROOT/config.zsh"

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_FIND_NO_DUPS
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY

# Completion: case-insensitive, partial-word, and substring matching
zstyle ':completion:*' matcher-list \
  'm:{a-z}={A-Za-z}' \
  'r:|[._-]=* r:|=* l:|=*' \
  'r:[^/]=**'

# Ignore compiled/binary file extensions in completion
FIGNORE=".class:.pyc:.o:.so:.swp:.bak"

# Tab menu: show menu when multiple matches, allow arrow-key navigation
zstyle ':completion:*' menu select=2
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' verbose yes
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%B%d%b'

# Git: cache completion for speed
zstyle ':completion:*:git-*' cache-policy '*' use-cache yes

# Initialize completion system
autoload -Uz compinit && compinit

# Load core files
source "$ZSH_ROOT/core/prompt.zsh"
source "$ZSH_ROOT/core/aliases.zsh"
source "$ZSH_ROOT/core/command-not-found.zsh"
source "$ZSH_ROOT/core/plugins.zsh"
export PATH="$HOME/.local/bin:$PATH"

# fzf: fuzzy finder key bindings (Ctrl+T, Ctrl+R, Alt+C) and completion
source /usr/share/fzf/shell/key-bindings.zsh 2>/dev/null
source /usr/share/fzf/shell/completion.zsh 2>/dev/null

# zoxide: smart directory jumping (z, zi, zq)
eval "$(zoxide init zsh)"

bwuser () {
  bw get item "$1" | jq -r '.login.username'
}

bwpass() {
    bw get item "$1" --session "$BW_SESSION" \
        | jq -r '.login.password' \
        | wl-copy
    echo "Password copied"
}

bwunlock() {
    export BW_SESSION=$(NODE_NO_WARNINGS=1 bw unlock --raw )
}

# Windows paths (WSL)
export WINHOME="/mnt/c/Users/zharkaron"
alias doc='cd "$WINHOME/Documents"'
alias down='cd "$WINHOME/Downloads"'
alias desk='cd "$WINHOME/Desktop"'

# Quick copy: cp file → Windows Documents
cpdoc() { cp -v "$1" "$WINHOME/Documents/"; }
cpdown() { cp -v "$1" "$WINHOME/Downloads/"; }

# forgit: fuzzy git operations (glo, gca, gcf, etc. — type g + tab to see all)
if [[ -f "$HOME/.forgit/forgit.plugin.zsh" ]]; then
  source "$HOME/.forgit/forgit.plugin.zsh"
fi

# delta: better git diff with syntax highlighting and side-by-side
if command -v delta &>/dev/null; then
  export GIT_PAGER="delta"
  git config --global core.pager "delta" 2>/dev/null
  git config --global interactive.diffFilter "delta --color-only" 2>/dev/null
fi
