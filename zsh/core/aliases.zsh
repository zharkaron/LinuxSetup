# Custom or nesseary alias needed

# ls aliases (eza — modern ls with icons & git status)
alias ls='eza --icons'
alias la='eza -a --icons'
alias ll='eza -l --icons --git'
alias lla='eza -la --icons --git'
alias lt='eza --tree --level=2 --icons'

# cat aliases (bat — with syntax highlighting, no pager)
alias cat='bat --paging=never'

# vim aliases
alias v='nvim'
alias vi='nvim'
alias vim='nvim'
