#!/bin/bash
# update_ssh – Sync ~/.ssh/authorized_keys with a GitHub user's public keys.
#
# Reusable script – just set LINUXSETUP_GITHUB_USER to any GitHub username.
#
# Environment variables (set in zsh/config.zsh):
#   LINUXSETUP_GITHUB_USER   GitHub username whose keys to trust (default: zh4rkaron)

set -e

GITHUB_USER="${LINUXSETUP_GITHUB_USER:?Error: LINUXSETUP_GITHUB_USER is not set}"
AUTHORIZED_KEYS="$HOME/.ssh/authorized_keys"

if [ $# -gt 0 ]; then
  echo "Usage: $0"
  echo "Updates ~/.ssh/authorized_keys from https://github.com/$GITHUB_USER.keys"
  exit 1
fi

/bin/mkdir -p "$HOME/.ssh"
/bin/chmod 700 "$HOME/.ssh"

git_keys=$(/usr/bin/curl -s "https://github.com/$GITHUB_USER.keys")
if [ -z "$git_keys" ]; then
  echo "$(date): No keys found or failed to fetch keys for $GITHUB_USER" >> "$HOME/ssh_key_update.log"
  exit 1
fi

if [ -f "$AUTHORIZED_KEYS" ]; then
  local_keys=$(/bin/cat "$AUTHORIZED_KEYS")
else
  local_keys=""
fi

if [[ "$git_keys" == "$local_keys" ]]; then
  echo "$(date): SSH keys are up to date." >> "$HOME/ssh_key_update.log"
else
  echo "$git_keys" > "$AUTHORIZED_KEYS"
  /bin/chmod 600 "$AUTHORIZED_KEYS"
  echo "$(date): SSH keys updated." >> "$HOME/ssh_key_update.log"
fi
