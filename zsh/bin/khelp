#!/usr/bin/env zsh
# khelp – Display the kitty README (keybinding reference).
#
# Personal script – assumes kitty README is installed at ~/.config/kitty/README.md.

README="$HOME/.config/kitty/README.md"

if [[ -f $README ]]; then
    cat "$README"
else
    echo "kitty README not found at $README"
fi
